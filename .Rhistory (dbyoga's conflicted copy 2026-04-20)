make_multi_panel <- function(G = 30L, T = 8L,
adopt_times = NULL,
group_sizes = NULL,
tau_fun = function(k) ifelse(k >= 0, 1 + 0.6*k, 0),
noise_sd = 1) {
if (is.null(adopt_times)) {
adopt_times <- sample(c(3L, 4L, 5L, 6L, Inf), G, replace = TRUE,
prob = c(0.15, 0.25, 0.25, 0.20, 0.15))
}
if (is.null(group_sizes)) {
group_sizes <- round(exp(rnorm(G, 6.3, 0.7)))  # very unbalanced
}
dtg <- data.table(g = factor(seq_len(G)),
adopt = adopt_times,
Ng = group_sizes)
dtt <- data.table(t = factor(seq_len(T)))
cells <- dtg[, .(g, adopt, Ng)][dtt, on = .(dummy=NA)][, dummy := NULL]
cells[, t_int := as.integer(as.character(t))]
cells[, D := as.integer(t_int >= adopt)]
cells[is.infinite(adopt), D := 0L]
cells[, k := t_int - adopt]
cells[is.infinite(adopt), k := NA_integer_]
cells[, Delta := 0.0]
cells[D == 1, Delta := tau_fun(k)]
dat <- cells[rep(.I, times = Ng)]
dat[, u := rnorm(.N, sd = noise_sd)]
dat[, Y0 := u]
dat[, Y  := Y0 + D * Delta]
list(cells = cells, dat = dat, dtg = dtg)
}
