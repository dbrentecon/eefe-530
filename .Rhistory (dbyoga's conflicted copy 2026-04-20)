resid_D <- function(dt) resid(lm(D ~ g + t, data = dt))
did_2x2 <- function(dt, g_treat, g_ctrl, t_pre, t_post) {
m <- dt[g %in% c(g_treat, g_ctrl) & t %in% c(t_pre, t_post),
.(Y = mean(Y)), by = .(g, t)]
yt_post <- m[g == g_treat & t == t_post, Y]
yt_pre  <- m[g == g_treat & t == t_pre,  Y]
yc_post <- m[g == g_ctrl  & t == t_post, Y]
yc_pre  <- m[g == g_ctrl  & t == t_pre,  Y]
(yt_post - yt_pre) - (yc_post - yc_pre)
}
bacon_minimal <- function(dat) {
comps <- data.table(
comp = c("Early vs Late (1->2): g2 treated, g1 not-yet",
"Late vs Early (2->3): g1 treated, g2 already-treated"),
g_treat = factor(c(2,1)),
g_ctrl  = factor(c(1,2)),
t_pre   = factor(c(1,2)),
t_post  = factor(c(2,3)),
type    = c("good (not-yet-treated control)", "bad (already-treated control)")
)
comps[, `:=`(did = NA_real_, w_raw = NA_real_)]
for (i in 1:nrow(comps)) {
gi_t <- comps[i, g_treat]
gi_c <- comps[i, g_ctrl]
ti_0 <- comps[i, t_pre]
ti_1 <- comps[i, t_post]
sub <- dat[g %in% c(gi_t, gi_c) & t %in% c(ti_0, ti_1), .(g, t, D, Y)]
comps[i, did := did_2x2(dat, gi_t, gi_c, ti_0, ti_1)]
e <- resid_D(sub)
comps[i, w_raw := var(e)]
}
comps[, w := w_raw / sum(w_raw)]
comps[, contribution := w * did]
comps
}
